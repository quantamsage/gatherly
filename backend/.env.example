# Copy to .env for local development. Never commit .env.

# Postgres connection for the restricted app role (rsvp_app), NOT the owner.
# Locally: create rsvp_dev, run db/schema.sql, then ALTER ROLE rsvp_app WITH PASSWORD ...
DATABASE_URL=postgresql://rsvp_app:your-password@localhost:5432/rsvp_dev

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=30

# Comma-separated list of allowed frontend origins. Never "*".
CORS_ORIGINS=http://localhost:3000

# "development" or "production" (production turns on HSTS)
APP_ENV=development
